__pycache__/
*.pyc
.venv/
.DS_Store

# Local secrets (MISTRAL_API_KEY etc.) -- never committed
.env

# Notes, not deliverables
notepad/

# Derived corpus artifacts: rebuild with scripts/build_corpus.py
corpus/chunks/*
!corpus/chunks/.gitkeep

# Extraction caches: rebuild from the sources in corpus/raw
build/

# logs/ is tracked on purpose (since 2026-09-15): the model_calls_real_*.txt
# transcripts are the evidence behind the quality spot-check docs, and they
# cannot be regenerated identically -- providers retire models and answers
# drift. All content in them is synthetic exam data; no keys are ever logged.

# Mutation variants are reproducible from a seed, so ground truth cannot
# drift from the variants (tech doc 9).
mutations/*
!mutations/.gitkeep

# pytest
.pytest_cache/
