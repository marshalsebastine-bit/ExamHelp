            "erwartungspunkte": [
              {
                "text": "erhoehter Blutdruck",
                "punkte": 4.0
              },
              {
                "text": "bisher nicht umgesetzte Ernaehrungsumstellung",
                "punkte": 4.0
              }
            ]
          },
