    {
      "fallsituation": {
        "text": "Herr Wiesner ist 71 Jahre alt und wird nach einem Sturz zu Hause mit dem Rettungsdienst eingeliefert. Er ist wach und orientiert, klagt aber ueber starke Schmerzen im linken Unterarm. Der Arm ist sichtbar fehlgestellt und geschwollen. Herr Wiesner nimmt Metformin wegen eines Diabetes mellitus Typ 2 ein. Sein Blutzucker betraegt bei Aufnahme 68 mg/dl. Er ist blass und leicht schwitzig. Herr Wiesner sagt, er habe seit dem Fruehstueck nichts mehr gegessen.",
        "titel": "Herr Wiesner - Sturz mit Verdacht auf Unterarmfraktur",
        "versorgungsbereich": "stationaer_akut",
        "altersgruppe": "alter_mensch"
      },
      "teilaufgaben": [
        {
          "text": "Benennen Sie 4 Beobachtungen bei Herrn Wiesner, die auf eine ernste gesundheitliche Lage hinweisen.",
          "anforderungsniveau": "I",
          "punkte": 6.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "sichtbare Fehlstellung und Schwellung des Unterarms",
                "punkte": 1.5
              },
              {
                "text": "Blutzucker von 68 mg/dl",
                "punkte": 1.5
              },
              {
                "text": "Blaesse und Schwitzen",
                "punkte": 1.5
              },
              {
                "text": "fehlende Nahrungsaufnahme seit dem Fruehstueck",
                "punkte": 1.5
              }
            ]
          },
          "kompetenzanforderung": "Wissen",
          "situationsmerkmale": {
