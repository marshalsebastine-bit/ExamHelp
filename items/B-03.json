  "aufgaben": [
    {
      "fallsituation": {
        "text": "Frau Lindqvist ist 88 Jahre alt und lebt seit 4 Jahren in einer Pflegeeinrichtung. Sie hat eine fortgeschrittene Herzinsuffizienz. In den letzten 2 Wochen hat sie 3 Kilogramm abgenommen und isst nur noch wenige Loeffel pro Mahlzeit. Frau Lindqvist schlaeft tagsueber viel und spricht kaum. Sie hat eine Patientenverfuegung, die lebensverlaengernde Massnahmen ablehnt. Ihr Sohn fordert die Verlegung ins Krankenhaus und eine Infusionstherapie. Die Hausaerztin haelt eine palliative Begleitung fuer angezeigt. Eine Pflegehelferin sagt im Dienstzimmer, man koenne sie doch nicht einfach verhungern lassen.",
        "titel": "Frau Lindqvist - Palliative Begleitung bei fortgeschrittener Herzinsuffizienz",
        "versorgungsbereich": "stationaer_langzeit",
        "altersgruppe": "alter_mensch"
      },
      "teilaufgaben": [
        {
          "text": "Benennen Sie 4 Beobachtungen bei Frau Lindqvist, die auf die letzte Lebensphase hinweisen.",
          "anforderungsniveau": "I",
          "punkte": 6.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "Gewichtsabnahme von 3 Kilogramm in 2 Wochen",
                "punkte": 1.5
              },
              {
                "text": "deutlich reduzierte Nahrungsaufnahme",
                "punkte": 1.5
              },
              {
                "text": "zunehmende Schlafdauer am Tag",
                "punkte": 1.5
              },
              {
                "text": "nachlassende verbale Kommunikation",
                "punkte": 1.5
              }
            ]
          },
          "kompetenzanforderung": "Wissen",
          "situationsmerkmale": {
