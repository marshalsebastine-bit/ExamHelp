          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "Mundpflege zur Linderung von Durstgefuehl und Mundtrockenheit",
                "punkte": 3.0
              },
              {
                "text": "Nahrungs- und Fluessigkeitsangebot nach Wunsch ohne Zwang",
                "punkte": 3.0
              },
              {
                "text": "Positionierung und Hautpflege zur Vermeidung von Druckschmerz",
                "punkte": 3.0
              }
            ]
