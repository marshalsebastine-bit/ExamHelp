            "erwartungspunkte": [
              {
                "text": "Aussenrotation und Verkuerzung des rechten Beins",
                "punkte": 1.5
              },
              {
                "text": "Schmerzen in der Hueftregion",
                "punkte": 1.5
              },
              {
                "text": "Platzwunde an der Stirn unter Antikoagulation",
                "punkte": 1.5
              },
              {
                "text": "verlangsamte Reaktion",
