    {
      "fallsituation": {
        "text": "Frau Yilmaz, welche seit einiger Zeit unter einer im Zusammenhang mit einer depressiven Episode stehenden Antriebsminderung leidet, deren Verlauf bislang nicht klar abzuschaetzen ist, wurde von den Mitpatienten dabei beobachtet, wie sie sich, ohne dass hierfuer eine unmittelbare Ursache erkennbar gewesen waere, in ihr Zimmer zurueckgezogen habe und dort ueber laengere Zeit verharrt sei. Es wird angenommen, dass eine Ansprache erfolgen sollte.",
        "titel": "Frau Yilmaz - Sozialer Rueckzug bei depressiver Episode",
        "versorgungsbereich": "psychiatrisch",
        "altersgruppe": "erwachsener"
      },
      "teilaufgaben": [
        {
          "text": "Nennen Sie Beobachtungen zum Rueckzug von Frau Yilmaz.",
          "anforderungsniveau": "I",
          "punkte": 8.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "laengerer Rueckzug ins Zimmer",
                "punkte": 4.0
              },
