              "CE 11"
            ]
          },
          "kompetenzzuordnung_abgeleitet": [
            "I.2.g",
            "II.1.a"
          ]
        },
        {
          "text": "Nennen Sie 2 rechtliche Grundlagen fuer freiheitsentziehende Massnahmen.",
          "anforderungsniveau": "I",
          "punkte": 6.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "richterliche Genehmigung erforderlich",
