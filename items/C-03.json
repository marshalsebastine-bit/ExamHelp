      "fallsituation": {
        "text": "Herr Petrovic ist 47 Jahre alt und seit 5 Tagen auf einer psychiatrischen Station. Er hat eine paranoide Schizophrenie. Herr Petrovic hat die Medikamenteneinnahme vor 3 Wochen beendet. Er aeussert die Ueberzeugung, dass die Nachbarn ihn abhoeren. In der Nacht ist er unruhig und laeuft im Flur auf und ab. Am Morgen spricht er Sie mit lauter Stimme an und wirft einen Stuhl um. Zwei Mitpatienten verlassen den Aufenthaltsraum. Herr Petrovic arbeitet als Lagerlogistiker und hat eine 12-jaehrige Tochter.",
        "titel": "Herr Petrovic - Akute psychotische Krise bei paranoider Schizophrenie",
        "versorgungsbereich": "psychiatrisch",
        "altersgruppe": "erwachsener"
      },
      "teilaufgaben": [
        {
          "text": "Nennen Sie 3 Beobachtungen bei Herrn Petrovic und bewerten Sie diese hinsichtlich einer Eigen- oder Fremdgefaehrdung.",
          "anforderungsniveau": "I",
          "punkte": 8.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "naechtliche Unruhe",
                "punkte": 2.0
              },
              {
                "text": "lautes Ansprechen und Umwerfen eines Stuhls",
                "punkte": 3.0
              },
              {
                "text": "Wahnerleben bezogen auf die Nachbarn",
                "punkte": 3.0
              }
            ]
          },
          "kompetenzanforderung": "Wissen",
          "situationsmerkmale": {
            "handlungsanlaesse": [
              "akute psychotische Symptomatik",
              "Absetzen der Medikation",
              "angespannte Situation mit Gefaehrdungspotenzial"
            ],
            "kontextbedingungen": [
              "psychiatrische Akutstation",
              "Mitpatienten im Umfeld"
            ],
            "handlungsmuster": [
              "Deeskalation",
              "Beziehungsgestaltung",
              "Umgang mit Zwangskontext"
            ],
            "curriculare_einheit": [
              "CE 11"
            ]
          },
          "kompetenzzuordnung_abgeleitet": [
            "I.3.a"
          ]
        },
        {
          "text": "Nennen Sie 3 deeskalierende Massnahmen fuer die Situation im Aufenthaltsraum.",
          "anforderungsniveau": "I",
          "punkte": 6.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "Reizreduktion herstellen",
                "punkte": 2.0
              },
              {
                "text": "ruhige Ansprache mit Abstand",
                "punkte": 2.0
              },
              {
                "text": "Mitpatienten schuetzen",
                "punkte": 2.0
              }
            ]
          },
          "kompetenzanforderung": "Wissen",
          "situationsmerkmale": {
            "handlungsanlaesse": [
              "akute psychotische Symptomatik",
              "Absetzen der Medikation",
              "angespannte Situation mit Gefaehrdungspotenzial"
