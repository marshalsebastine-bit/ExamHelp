    {
      "fallsituation": {
        "text": "Lina ist 7 Jahre alt und liegt seit 1 Tag auf der Kinderstation. Sie hat eine Pneumonie. Um 14 Uhr messen Sie eine Atemfrequenz von 38 pro Minute und eine Sauerstoffsaettigung von 89 Prozent. Lina sitzt aufrecht im Bett und stuetzt sich mit beiden Armen ab. Ihre Lippen sind blaeulich verfaerbt. Sie spricht nur in kurzen Abschnitten und wirkt unruhig. Die Mutter ist anwesend und beginnt zu weinen. Der Arzt ist im Operationsbereich und nicht sofort erreichbar. Auf dem Flur wartet eine weitere Familie auf ein Aufnahmegespraech.",
        "titel": "Lina - Akute Atemnot bei Pneumonie",
        "versorgungsbereich": "paediatrisch",
        "altersgruppe": "kind"
      },
      "teilaufgaben": [
        {
          "text": "Benennen Sie 4 Beobachtungen bei Lina, die auf eine akute Verschlechterung hinweisen.",
          "anforderungsniveau": "I",
          "punkte": 6.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "Atemfrequenz von 38 pro Minute",
                "punkte": 1.5
              },
              {
                "text": "Sauerstoffsaettigung von 89 Prozent",
                "punkte": 1.5
              },
              {
                "text": "Zyanose der Lippen",
                "punkte": 1.5
              },
              {
                "text": "Einsatz der Atemhilfsmuskulatur und Sprechen in kurzen Abschnitten",
                "punkte": 1.5
              }
            ]
          },
          "kompetenzanforderung": "Wissen",
          "situationsmerkmale": {
            "handlungsanlaesse": [
              "akute respiratorische Verschlechterung",
              "beginnende Kreislaufinstabilitaet",
              "Angst bei Kind und Bezugsperson"
            ],
            "kontextbedingungen": [
              "Kinderstation",
              "Arzt nicht sofort verfuegbar",
              "gleichzeitige konkurrierende Aufgaben"
            ],
            "handlungsmuster": [
              "Notfallersteinschaetzung",
              "Sofortmassnahmen",
              "Kommunikation in der Krise"
            ],
            "curriculare_einheit": [
              "CE 06"
            ]
          },
          "kompetenzzuordnung_abgeleitet": [
            "I.4.a"
          ]
        },
        {
          "text": "Bestimmen Sie 3 Sofortmassnahmen, die Sie bei Lina vor Eintreffen des Arztes durchfuehren.",
          "anforderungsniveau": "II",
          "punkte": 9.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "atemunterstuetzende Positionierung beibehalten und sichern",
                "punkte": 3.0
              },
              {
                "text": "Sauerstoffgabe nach Standard einleiten",
                "punkte": 3.0
              },
              {
                "text": "Vitalparameter kontinuierlich ueberwachen und Notruf ausloesen",
                "punkte": 3.0
              }
            ]
          },
          "kompetenzanforderung": "Analyse/Synthese",
          "situationsmerkmale": {
            "handlungsanlaesse": [
              "akute respiratorische Verschlechterung",
              "beginnende Kreislaufinstabilitaet",
              "Angst bei Kind und Bezugsperson"
            ],
            "kontextbedingungen": [
              "Kinderstation",
              "Arzt nicht sofort verfuegbar",
              "gleichzeitige konkurrierende Aufgaben"
