            "handlungsmuster": [
              "Notfallersteinschaetzung",
              "Sofortmassnahmen",
              "Kommunikation in der Krise"
            ],
            "curriculare_einheit": [
              "CE 06"
            ]
          },
          "kompetenzzuordnung_abgeleitet": [
            "I.4.b"
          ]
        },
        {
          "text": "Erlaeutern Sie 2 Aspekte, die Sie bei der Durchfuehrung der aerztlichen Anordnung zur Sauerstoffgabe beachten.",
          "anforderungsniveau": "II",
          "punkte": 7.0,
          "erwartungshorizont": {
            "erwartungspunkte": [
              {
                "text": "Anordnung auf Vollstaendigkeit und Plausibilitaet pruefen",
                "punkte": 3.5
              },
              {
                "text": "Wirkung kontrollieren und Abweichungen unverzueglich rueckmelden",
                "punkte": 3.5
              }
            ]
          },
          "kompetenzanforderung": "Analyse/Synthese",
